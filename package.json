{
  "name": "prompt-with-weight-generator",
  "version": "1.0.0",
  "description": "GUI-based prompt generator with weighted tags",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:all": "electron-builder -mwl",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "prompt",
    "generator",
    "tags",
    "weight"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.promptgenerator.app",
    "productName": "Prompt Generator",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!.git",
      "!node_modules"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
